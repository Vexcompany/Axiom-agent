# Axiom agent — server-side only (never NEXT_PUBLIC_*)

# Sekai gateway (OpenAI-compatible)
# Base URL must end before /chat/completions (we append that path).
# Example shapes:
#   https://your-sekai-host/v1
#   https://api.example.com/v1
SEKAI_BASE_URL=
SEKAI_API_KEY=

# Optional default model id (must be one of the catalog ids)
# SEKAI_MODEL=free/gpt-5.6-luna

# Optional output cap
# SEKAI_MAX_TOKENS=4096
