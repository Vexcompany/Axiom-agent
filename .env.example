# Axiom AI RV v2 — server-side only (never commit real values)

# --- Preferred: Cloudflare chat worker (keys live on the Worker, not here) ---
# Server-only — do NOT use NEXT_PUBLIC_. Browser never sees this URL.
# Either form works (route normalizes so /chat is never doubled):
#   https://axiom-agent.vexcorporation43.workers.dev
#   https://axiom-agent.vexcorporation43.workers.dev/chat
CHAT_WORKER_URL=https://axiom-agent.vexcorporation43.workers.dev/chat

# --- Fallback: call providers directly from Next.js (if CHAT_WORKER_URL is unset) ---
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_APP_NAME=Axiom AI RV

CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Optional Sekai gateway
SEKAI_BASE_URL=
SEKAI_API_KEY=

# Cap output tokens (lower = less rate-limit pressure)
# AXIOM_MAX_TOKENS=2048
